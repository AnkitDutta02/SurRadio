# Copy to .env.local for local dev with `vercel dev`.
# In production these are set in the Vercel dashboard, never committed.

# Required for AI curation. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Improves song matching accuracy. Without it, public mirrors are used.
# Enable "YouTube Data API v3" at https://console.cloud.google.com
YOUTUBE_API_KEY=AIza...

# Optional. Defaults to claude-sonnet-4-6
# CLAUDE_MODEL=claude-sonnet-4-6
